# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://stt:stt@localhost:5433/stt

# Free key from https://aistudio.google.com/apikey . Leave empty to run with the open-source engine only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe-live

WHISPER_MODEL=../models/hinglish-swift
WHISPER_THREADS=2
# true: decode each finished sentence once more with beam search. Slower, a little more accurate.
WHISPER_RECHECK=false

MAX_SESSION_SECONDS=180
MAX_SESSIONS=4
